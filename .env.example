# ── Django ────────────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-key-here

# ── Database (PostgreSQL) ─────────────────────────────────────────
DB_NAME=zoro_db
DB_USER=zoro_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
DB_SSL_MODE=disable

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS S3 (for KYC document uploads) ────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=zoro-kyc-docs
AWS_REGION=ap-south-1

# ── Email (SendGrid) ──────────────────────────────────────────────
SENDGRID_API_KEY=
MAIL_FROM=noreply@zoro.finance

# ── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── 2FA ──────────────────────────────────────────────────────────
TOTP_APP_NAME=ZORO Admin
