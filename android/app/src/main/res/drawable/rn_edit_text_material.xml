<?xml version="1.0" encoding="utf-8"?>
<!--
  Default style for React Native's TextInput on Android — a plain underline
  that adopts the app's gold accent when focused, matching the standard
  React Native community template's drawable of the same name.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <size android:height="2dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="@color/app_gold" />
            <padding android:bottom="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#1F1F1F" />
            <padding android:bottom="1dp" />
        </shape>
    </item>
</selector>
